# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ── NVIDIA NIM (existing compliance agent) ────────────────────────────────────
NVIDIA_API_KEY=nvapi-your_key_here

# ── Google Gemini (augmentation — primary) ────────────────────────────────────
# Free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# ── Groq (augmentation — fallback) ───────────────────────────────────────────
# Free tier: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# ── Mistral AI (translation) ──────────────────────────────────────────────────
# Free tier: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your_mistral_key_here

# ── Cookie encryption (existing app) ─────────────────────────────────────────
COOKIE_PASSWORD=change_this_to_a_strong_secret
